PORT=7331
SELF_HOSTED_MODE=true
REQUIRE_LICENSE_KEY=true

# Database (Postgres password used by both app and db container)
POSTGRES_PASSWORD=change-me-to-something-secure
UPLOAD_PATH="/app/data/uploads"

# AI Provider (pick one)
OPENAI_MODEL_NAME="gpt-4o-mini"
OPENAI_API_KEY=""

GOOGLE_MODEL_NAME="gemini-2.5-flash"
GOOGLE_API_KEY=""

MISTRAL_MODEL_NAME="mistral-medium-latest"
MISTRAL_API_KEY=""

# Auth (use a long random string)
BETTER_AUTH_SECRET="change-this-to-a-random-secret-key"

# Stripe (for paid licenses)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email (for multi-user with OTP login)
RESEND_API_KEY=""
RESEND_AUDIENCE_ID=""
RESEND_FROM_EMAIL="FreightBooks <noreply@freightbooks.app>"
